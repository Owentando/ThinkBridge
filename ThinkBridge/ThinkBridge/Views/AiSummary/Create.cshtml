@{
    ViewBag.Title = "Create AI Summary";
    var materialTitle = ViewBag.MaterialTitle as string;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0"><i class="fas fa-magic me-2"></i>AI Content Summarizer</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    Paste any educational text below and our AI will generate a clear, concise summary with key points.
                </div>

                @using (Html.BeginForm("Create", "AiSummary", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title</label>
                        <input type="text" name="title" class="form-control" value="@materialTitle" placeholder="Give your summary a title" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Text to Summarize</label>
                        <textarea name="text" class="form-control" rows="12" placeholder="Paste your course notes, textbook content, or any educational text here..." required></textarea>
                        <small class="text-muted">Tip: Longer texts produce more comprehensive summaries.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-magic me-2"></i>Generate Summary
                        </button>
                        <a href="@Url.Action("Index", "AiSummary")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>