@model ThinkBridge.Models.AiSummary

@using Markdig

@{
    ViewBag.Title = Model.Title;

    var formattedSummary = Markdown.ToHtml(Model.SummaryText ?? "");
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "AiSummary")">AI Summaries</a>
            </li>

            <li class="breadcrumb-item active">
                @Model.Title
            </li>
        </ol>
    </nav>
</div>

<div class="row">

    <!-- ORIGINAL TEXT -->

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">

            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="fas fa-file-alt me-2"></i>
                    Original Text
                </h6>

                <span class="badge bg-secondary">
                    Input
                </span>
            </div>

            <div class="card-body">
                <div style="max-height: 500px; overflow-y: auto;">

                    <div style="white-space: pre-wrap; line-height: 1.9;">
                        @Model.OriginalText
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- AI SUMMARY -->

    <div class="col-lg-6 mb-4">

        <div class="card shadow-sm h-100 border-primary">

            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">

                <h6 class="mb-0">
                    <i class="fas fa-robot me-2"></i>
                    AI Summary
                </h6>

                <span class="badge bg-white text-primary">
                    AI Generated
                </span>

            </div>

            <div class="card-body">

                <div style="max-height: 500px; overflow-y: auto;">

                    <div class="summary-content">

                        @Html.Raw(formattedSummary)

                    </div>

                </div>

            </div>

            <div class="card-footer bg-light">

                <small class="text-muted">
                    <i class="fas fa-calendar me-1"></i>
                    Generated: @Model.CreatedAt.ToString("g")
                </small>

            </div>

        </div>

    </div>

</div>

<div class="d-flex gap-2 mb-4">

    <a href="@Url.Action("Index", "AiSummary")"
       class="btn btn-outline-primary">

        <i class="fas fa-arrow-left me-2"></i>
        Back to Summaries

    </a>

    <a href="@Url.Action("Create", "AiSummary")"
       class="btn btn-primary">

        <i class="fas fa-plus me-2"></i>
        New Summary

    </a>

</div>

<style>

    .summary-content {
        line-height: 1.9;
        font-size: 15px;
    }

        .summary-content h1,
        .summary-content h2,
        .summary-content h3,
        .summary-content h4 {
            margin-top: 24px;
            margin-bottom: 16px;
            font-weight: 700;
            color: #2563eb;
        }

        .summary-content p {
            margin-bottom: 14px;
        }

        .summary-content ul {
            padding-left: 22px;
            margin-bottom: 18px;
        }

        .summary-content li {
            margin-bottom: 8px;
        }

        .summary-content strong {
            color: #111827;
        }

        .summary-content hr {
            margin: 24px 0;
            border-top: 1px solid #d1d5db;
        }

        .summary-content table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 20px;
        }

            .summary-content table th,
            .summary-content table td {
                border: 1px solid #d1d5db;
                padding: 10px;
            }

            .summary-content table th {
                background: #f3f4f6;
                font-weight: 600;
            }

        .summary-content code {
            background: #f3f4f6;
            padding: 2px 6px;
            border-radius: 6px;
            font-size: 13px;
        }
</style>