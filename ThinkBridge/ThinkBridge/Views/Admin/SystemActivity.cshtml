@model List<ThinkBridge.Models.ProgressRecord>
@{
    ViewBag.Title = "System Activity";
}

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Recent System Activity</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Activity</th>
                        <th>Type</th>
                        <th>Score</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activity in Model)
                    {
                        <tr>
                            <td><strong>@(activity.Student?.FullName ?? "Unknown")</strong></td>
                            <td>@activity.ActivityName</td>
                            <td>
                                <span class="badge @(activity.ActivityType == "Quiz" ? "bg-warning" : "bg-info")">@activity.ActivityType</span>
                            </td>
                            <td>
                                @if (activity.Score.HasValue)
                                {
                                    <span class="badge @(activity.Score >= 70 ? "bg-success" : activity.Score >= 50 ? "bg-warning" : "bg-danger")">@activity.Score%</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-muted">@activity.CompletedAt.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-chart-line fa-3x mb-3"></i>
                <h5>No activity recorded yet</h5>
            </div>
        }
    </div>
</div>