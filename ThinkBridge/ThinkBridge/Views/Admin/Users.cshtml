@model List<ThinkBridge.Models.User>
@{
    ViewBag.Title = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-users-cog me-2"></i>User Management</h4>
    <a href="@Url.Action("CreateLecturer", "Admin")" class="btn btn-primary">
        <i class="fas fa-user-plus me-2"></i>Create Lecturer
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td><strong>@user.FullName</strong></td>
                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @(user.Role == "Admin" ? "bg-warning text-dark" : user.Role == "Lecturer" ? "bg-info" : "bg-success")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (user.Role != "Admin")
                                {
                                    using (Html.BeginForm("ToggleUserStatus", "Admin", new { id = user.Id }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                                            @(user.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-users-slash fa-3x mb-3"></i>
                <h5>No users found</h5>
            </div>
        }
    </div>
</div>