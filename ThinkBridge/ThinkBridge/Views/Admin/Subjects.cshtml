@model List<ThinkBridge.Models.Subject>
@{
    ViewBag.Title = "All Subjects";
}

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0"><i class="fas fa-book me-2"></i>All Subjects</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Lecturer</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in Model)
                    {
                        <tr>
                            <td><strong>@subject.Name</strong></td>
                            <td>@subject.Description</td>
                            <td>@(subject.Lecturer?.FullName ?? "N/A")</td>
                            <td class="text-muted">@subject.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-book-open fa-3x mb-3"></i>
                <h5>No subjects found</h5>
            </div>
        }
    </div>
</div>