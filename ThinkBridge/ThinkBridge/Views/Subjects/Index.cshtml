@model List<ThinkBridge.Models.Subject>
@{
    ViewBag.Title = "Subjects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-book me-2"></i>Subjects</h4>
    <a href="@Url.Action("Create", "Subjects")" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Create Subject
    </a>
</div>

<div class="row">
    @foreach (var subject in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">@subject.Name</h5>
                        <span class="badge bg-info">@(subject.Topics != null ? subject.Topics.Count : 0) Topics</span>                    </div>
                    <p class="card-text text-muted">@subject.Description</p>
                    <small class="text-muted d-block mb-3">
                        <i class="fas fa-chalkboard-teacher me-1"></i>@(subject.Lecturer.FullName ?? "Unknown")
                    </small>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Details", "Subjects", new { id = subject.Id })" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-eye me-1"></i>View
                        </a>
                        <a href="@Url.Action("Index", "Topics", new { subjectId = subject.Id })" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-list me-1"></i>Topics
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-book-open fa-3x mb-3"></i>
        <h5>No subjects available</h5>
        @if (Session["Role"].ToString() == "Lecturer")
        {
            <p>Create your first subject to get started.</p>
        }
    </div>
}