@{
    ViewBag.Title = "Lecturer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h2 class="text-gradient">Welcome, @Session["DisplayName"]!</h2>
    <p class="text-muted">Lecturer Dashboard</p>

    <div class="row g-4 mt-3">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-book fa-3x text-primary mb-3"></i>
                    <h5>Subjects</h5>
                    <a href="@Url.Action("Index", "Subjects")" class="btn btn-primary btn-sm">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-file-alt fa-3x text-success mb-3"></i>
                    <h5>Materials</h5>
                    <a href="@Url.Action("Index", "CourseMaterials")" class="btn btn-success btn-sm">View</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-video fa-3x text-info mb-3"></i>
                    <h5>Videos</h5>
                    <a href="@Url.Action("Index", "VideoLessons")" class="btn btn-info btn-sm">View</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-question-circle fa-3x text-warning mb-3"></i>
                    <h5>Quizzes</h5>
                    <a href="@Url.Action("Index", "Quizzes")" class="btn btn-warning btn-sm">Manage</a>
                </div>
            </div>
        </div>
    </div>
</div>