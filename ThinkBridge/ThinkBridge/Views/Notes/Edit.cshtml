@model ThinkBridge.Models.PersonalNote
@{
    ViewBag.Title = "Edit Note";
    var topics = ViewBag.Topics as List<ThinkBridge.Models.Topic>;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Note</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Edit", "Notes", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Link to Topic (Optional)</label>
                        <select name="TopicId" class="form-select">
                            <option value="">No specific topic</option>
                            @foreach (var topic in topics)
                            {
                                <option value="@topic.Id" @(Model.TopicId == topic.Id ? "selected" : "")>@topic.Name (@topic.Subject.Name)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Content, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Content, new { @class = "form-control", rows = 8 })
                        @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Update Note
                        </button>
                        <a href="@Url.Action("Index", "Notes")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>