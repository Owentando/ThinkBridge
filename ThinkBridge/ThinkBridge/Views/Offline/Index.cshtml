@model List<ThinkBridge.Models.OfflineSavedItem>
@{
    ViewBag.Title = "Offline Collection";
    var materials = Model.Where(i => i.ItemType == "Material").ToList();
    var videos = Model.Where(i => i.ItemType == "Video").ToList();
    var notes = Model.Where(i => i.ItemType == "Note").ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-wifi-slash me-2"></i>Offline Collection</h4>
    <a href="@Url.Action("StudyPage", "Offline")" class="btn btn-primary">
        <i class="fas fa-book-open me-2"></i>Study Offline
    </a>
</div>

@if (Model.Any())
{
    @if (materials.Any())
    {
        <h5 class="mb-3"><i class="fas fa-file-alt me-2"></i>Materials (@materials.Count)</h5>
        <div class="row mb-4">
            @foreach (var item in materials)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-file-alt text-primary"></i>
                                <h6 class="card-title mb-0">@item.Title</h6>
                            </div>
                            <small class="text-muted d-block mb-2">
                                <i class="fas fa-calendar me-1"></i>Saved: @item.SavedAt.ToString("MMM dd")
                            </small>
                            @using (Html.BeginForm("Remove", "Offline", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash me-1"></i>Remove
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (videos.Any())
    {
        <h5 class="mb-3"><i class="fas fa-video me-2"></i>Videos (@videos.Count)</h5>
        <div class="row mb-4">
            @foreach (var item in videos)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-video text-danger"></i>
                                <h6 class="card-title mb-0">@item.Title</h6>
                            </div>
                            <small class="text-muted d-block mb-2">
                                <i class="fas fa-calendar me-1"></i>Saved: @item.SavedAt.ToString("MMM dd")
                            </small>
                            @using (Html.BeginForm("Remove", "Offline", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash me-1"></i>Remove
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (notes.Any())
    {
        <h5 class="mb-3"><i class="fas fa-sticky-note me-2"></i>Notes (@notes.Count)</h5>
        <div class="row mb-4">
            @foreach (var item in notes)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-sticky-note text-warning"></i>
                                <h6 class="card-title mb-0">@item.Title</h6>
                            </div>
                            <small class="text-muted d-block mb-2">
                                <i class="fas fa-calendar me-1"></i>Saved: @item.SavedAt.ToString("MMM dd")
                            </small>
                            @using (Html.BeginForm("Remove", "Offline", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash me-1"></i>Remove
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-wifi-slash fa-3x mb-3"></i>
        <h5>No offline items</h5>
        <p>Save materials, videos, and notes for offline study access.</p>
        <div class="mt-3">
            <a href="@Url.Action("Index", "CourseMaterials")" class="btn btn-outline-primary me-2">
                <i class="fas fa-file-alt me-2"></i>Browse Materials
            </a>
            <a href="@Url.Action("Index", "VideoLessons")" class="btn btn-outline-danger me-2">
                <i class="fas fa-video me-2"></i>Browse Videos
            </a>
            <a href="@Url.Action("Index", "Notes")" class="btn btn-outline-warning">
                <i class="fas fa-sticky-note me-2"></i>My Notes
            </a>
        </div>
    </div>
}