@model IEnumerable<ThinkBridge.Models.ViewModels.ResourceLinkViewModel>

@{
    ViewBag.Title = "Learning Resources";
}

<div class="container py-4">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="fw-bold mb-2">
                <i class="fas fa-book-open text-primary"></i>
                AI Suggested Learning Resources
            </h2>

            <p class="text-muted">
                Access tutorials, videos, research papers, and coding resources.
            </p>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body">

                        <span class="badge bg-primary mb-2">
                            @item.Type
                        </span>

                        <h5 class="fw-bold">
                            @item.Title
                        </h5>

                        <p class="text-muted">
                            Open external learning resource for this topic.
                        </p>

                        <a href="@item.Url"
                           target="_blank"
                           class="btn btn-primary">
                            Open Resource
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>

</div>