@model ThinkBridge.Models.CourseMaterial
@{
    ViewBag.Title = Model.Title;
    var subject = ViewBag.Subject as ThinkBridge.Models.Subject;
    var topic = ViewBag.Topic as ThinkBridge.Models.Topic;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "CourseMaterials")">Materials</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="fas @(Model.FileType == "PDF" ? "fa-file-pdf" : Model.FileType == "DOCX" || Model.FileType == "DOC" ? "fa-file-word" : "fa-file-alt") fa-3x"></i>
                    </div>
                    <div>
                        <h3 class="mb-1">@Model.Title</h3>
                        <span class="badge bg-primary">@Model.FileType</span>
                        <span class="badge bg-secondary">@(subject?.Name ?? "N/A")</span>
                        <span class="badge bg-light text-dark">@(topic?.Name ?? "N/A")</span>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-semibold">Description</h6>
                    <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <small class="text-muted d-block"><i class="fas fa-calendar me-1"></i>Uploaded: @Model.UploadDate.ToString("MMM dd, yyyy")</small>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block"><i class="fas fa-file me-1"></i>File Type: @Model.FileType</small>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("Download", "CourseMaterials", new { id = Model.Id })" class="btn btn-primary">
                        <i class="fas fa-download me-2"></i>Download File
                    </a>
                    <a href="@Url.Action("Index", "CourseMaterials")" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>