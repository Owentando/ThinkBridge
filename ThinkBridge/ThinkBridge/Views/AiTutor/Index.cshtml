@model List<ThinkBridge.Models.ChatMessage>
@{
    ViewBag.Title = "AI Tutor";
    var subjects = ViewBag.Subjects as List<ThinkBridge.Models.Subject>;
    var topics = ViewBag.Topics as List<ThinkBridge.Models.Topic>;
    var selectedSubjectId = ViewBag.SelectedSubjectId as int?;
    var selectedTopicId = ViewBag.SelectedTopicId as int?;
}

<div class="row mb-4">
    <div class="col-md-12">
        <div class="ai-card">
            <div class="d-flex align-items-center gap-3">
                <i class="fas fa-robot fa-3x"></i>
                <div>
                    <h4 class="mb-1">AI Tutor</h4>
                    <p class="mb-0 opacity-75">Ask me anything about your studies. I'm here to help!</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-comments me-2"></i>Chat</h6>
                    <a href="@Url.Action("History", "AiTutor")" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-history me-1"></i>History
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="chatMessages" class="chat-messages">
                    @if (Model.Any())
                    {
                        foreach (var msg in Model)
                        {
                            <div class="chat-message user">
                                <div class="message-bubble">@msg.Message</div>
                                <div class="message-time">@msg.CreatedAt.ToString("g")</div>
                            </div>
                            <div class="chat-message ai">
                                <div class="message-bubble">@Html.Raw(msg.Response.Replace("\n", "<br>"))</div>
                                <div class="message-time">@msg.CreatedAt.ToString("g")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted" id="emptyState">
                            <i class="fas fa-robot fa-3x mb-3"></i>
                            <h5>Start a conversation</h5>
                            <p>Ask me anything about your subjects!</p>
                        </div>
                    }
                </div>
                <div id="typingIndicator" class="px-4 py-2 d-none">
                    <small class="text-muted"><i class="fas fa-spinner fa-spin me-2"></i>AI is thinking...</small>
                </div>
                <div class="chat-input">
                    <input type="text" id="questionInput" class="form-control" placeholder="Type your question..." />
                    <button class="btn btn-primary" onclick="sendQuestion()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0"><i class="fas fa-filter me-2"></i>Context</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-muted">Subject (Optional)</label>
                    <select id="subjectSelect" class="form-select" onchange="loadTopics()">
                        <option value="">General</option>
                        @foreach (var subject in subjects)
                        {
                            <option value="@subject.Id" @(selectedSubjectId == subject.Id ? "selected" : "")>@subject.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Topic (Optional)</label>
                    <select id="topicSelect" class="form-select">
                        <option value="">General</option>
                        @foreach (var topic in topics)
                        {
                            <option value="@topic.Id" @(selectedTopicId == topic.Id ? "selected" : "")>@topic.Name</option>
                        }
                    </select>
                </div>
                <small class="text-muted">Selecting context helps me give more relevant answers.</small>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0"><i class="fas fa-lightbulb me-2"></i>Quick Questions</h6>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <button class="list-group-item list-group-item-action" onclick="setQuestion('Explain the concept of eigenvalues')">
                        <i class="fas fa-question-circle me-2 text-primary"></i>Explain eigenvalues
                    </button>
                    <button class="list-group-item list-group-item-action" onclick="setQuestion('What is Big O notation?')">
                        <i class="fas fa-question-circle me-2 text-primary"></i>What is Big O notation?
                    </button>
                    <button class="list-group-item list-group-item-action" onclick="setQuestion('How do binary search trees work?')">
                        <i class="fas fa-question-circle me-2 text-primary"></i>How do BSTs work?
                    </button>
                    <button class="list-group-item list-group-item-action" onclick="setQuestion('Explain matrix multiplication')">
                        <i class="fas fa-question-circle me-2 text-primary"></i>Matrix multiplication
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-messages {
        height: 400px;
        overflow-y: auto;
        padding: 20px;
        background: #f8fafc;
    }

    .chat-message {
        margin-bottom: 15px;
        max-width: 80%;
    }

        .chat-message.user {
            margin-left: auto;
        }

        .chat-message.ai {
            margin-right: auto;
        }

    .message-bubble {
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .chat-message.user .message-bubble {
        background: #4f46e5;
        color: white;
        border-bottom-right-radius: 4px;
    }

    .chat-message.ai .message-bubble {
        background: white;
        color: #334155;
        border: 1px solid #e2e8f0;
        border-bottom-left-radius: 4px;
    }

    .message-time {
        font-size: 0.7rem;
        color: #94a3b8;
        margin-top: 4px;
        text-align: right;
    }

    .chat-input {
        padding: 15px 20px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        gap: 10px;
        background: white;
    }

        .chat-input input {
            flex: 1;
        }

    .ai-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px;
        padding: 25px;
    }
</style>

@section scripts {
    <script>
        function setQuestion(text) {
            document.getElementById('questionInput').value = text;
            document.getElementById('questionInput').focus();
        }

        function loadTopics() {
            var subjectId = document.getElementById('subjectSelect').value;
            // In a real app, you'd AJAX load topics for the selected subject
        }

        function sendQuestion() {
            var input = document.getElementById('questionInput');
            var question = input.value.trim();
            if (!question) return;

            var subjectId = document.getElementById('subjectSelect').value;
            var topicId = document.getElementById('topicSelect').value;

            // Add user message to chat
            var chatMessages = document.getElementById('chatMessages');
            var emptyState = document.getElementById('emptyState');
            if (emptyState) emptyState.remove();

            var userMsg = document.createElement('div');
            userMsg.className = 'chat-message user';
            userMsg.innerHTML = '<div class="message-bubble">' + escapeHtml(question) + '</div><div class="message-time">Just now</div>';
            chatMessages.appendChild(userMsg);

            // Show typing indicator
            document.getElementById('typingIndicator').classList.remove('d-none');
            chatMessages.scrollTop = chatMessages.scrollHeight;

            input.value = '';
            input.disabled = true;

            $.post('@Url.Action("Ask", "AiTutor")', {
                Question: question,
                SubjectId: subjectId || null,
                TopicId: topicId || null,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(data) {
                document.getElementById('typingIndicator').classList.add('d-none');
                input.disabled = false;
                input.focus();

                if (data.success) {
                    var aiMsg = document.createElement('div');
                    aiMsg.className = 'chat-message ai';
                    aiMsg.innerHTML = '<div class="message-bubble">' + data.response.replace(/\n/g, '<br>') + '</div><div class="message-time">' + data.timestamp + '</div>';
                    chatMessages.appendChild(aiMsg);
                } else {
                    var errorMsg = document.createElement('div');
                    errorMsg.className = 'chat-message ai';
                    errorMsg.innerHTML = '<div class="message-bubble text-danger"><i class="fas fa-exclamation-circle me-2"></i>' + data.message + '</div>';
                    chatMessages.appendChild(errorMsg);
                }
                chatMessages.scrollTop = chatMessages.scrollHeight;
            });
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        document.getElementById('questionInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') sendQuestion();
        });
    </script>
}