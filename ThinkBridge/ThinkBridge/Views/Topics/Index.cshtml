@model List<ThinkBridge.Models.Topic>
@{
    ViewBag.Title = "Topics";
    var subjects = ViewBag.Subjects as List<ThinkBridge.Models.Subject>;
    var selectedSubjectId = ViewBag.SelectedSubjectId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-list me-2"></i>Topics</h4>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width: auto;" onchange="location.href='@Url.Action("Index", "Topics")?subjectId=' + this.value">
            <option value="">All Subjects</option>
            @foreach (var subject in subjects)
            {
                <option value="@subject.Id" @(selectedSubjectId == subject.Id ? "selected" : "")>@subject.Name</option>
            }
        </select>
        @if (Session["Role"].ToString() == "Lecturer" && selectedSubjectId.HasValue)
        {
            <a href="@Url.Action("Create", "Topics", new { subjectId = selectedSubjectId })" class="btn btn-primary btn-sm">
                <i class="fas fa-plus me-1"></i>Add Topic
            </a>
        }
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var topic in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0">@topic.Name</h6>
                            <span class="badge bg-secondary">@topic.Subject.Name</span>
                        </div>
                        <p class="card-text text-muted small">@topic.Description</p>
                        <div class="d-flex gap-2 mt-3">
                            <a href="@Url.Action("Index", "CourseMaterials", new { topicId = topic.Id })" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-file-alt me-1"></i>Materials
                            </a>
                            <a href="@Url.Action("Index", "VideoLessons", new { topicId = topic.Id })" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-video me-1"></i>Videos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-list fa-3x mb-3"></i>
        <h5>No topics found</h5>
    </div>
}