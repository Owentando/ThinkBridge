<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ThinkBridge</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="~/Content/site.css" rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>
<body>
    <div class="wrapper">
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <h3><i class="fas fa-graduation-cap me-2"></i>ThinkBridge</h3>
                <small class="text-white-50">AI Learning Assistant</small>
            </div>

            <div class="sidebar-user">
                @if (Session["UserId"] != null)
                {
                    <div class="d-flex align-items-center gap-3 p-3">
                        <div class="user-avatar">
                            <i class="fas fa-user-circle fa-2x text-white"></i>
                        </div>
                        <div class="text-white">
                            <div class="fw-semibold">@Session["DisplayName"]</div>
                            <small class="text-white-50">@Session["Role"]</small>
                        </div>
                    </div>
                }
            </div>

            <ul class="list-unstyled components">
                @{
                    var role = Session["Role"] != null ? Session["Role"].ToString() : "";
                    var currentController = ViewContext.RouteData.Values["controller"] != null
                        ? ViewContext.RouteData.Values["controller"].ToString()
                        : "";
                    var currentAction = ViewContext.RouteData.Values["action"] != null
                        ? ViewContext.RouteData.Values["action"].ToString()
                        : "";
                }

                @if (role == "Admin")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "Admin")">
                            <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")"
                           href="@Url.Action("Users", "Admin")">
                            <i class="fas fa-users me-2"></i>Manage Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Admin" && currentAction == "Subjects" ? "active" : "")"
                           href="@Url.Action("Subjects", "Admin")">
                            <i class="fas fa-book me-2"></i>All Subjects
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Admin" && currentAction == "SystemActivity" ? "active" : "")"
                           href="@Url.Action("SystemActivity", "Admin")">
                            <i class="fas fa-chart-line me-2"></i>System Activity
                        </a>
                    </li>
                }

                @if (role == "Student" || role == "Lecturer")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Student" ? "active" : "")"
                           href="@Url.Action("Dashboard", "Student")">
                            <i class="fas fa-home me-2"></i>Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Subjects" ? "active" : "")"
                           href="@Url.Action("Index", "Subjects")">
                            <i class="fas fa-book me-2"></i>Subjects
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Notes" ? "active" : "")"
                           href="@Url.Action("Index", "Notes")">
                            <i class="fas fa-sticky-note me-2"></i>My Notes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "CourseMaterials" ? "active" : "")"
                           href="@Url.Action("Index", "CourseMaterials")">
                            <i class="fas fa-link me-2"></i>Resources
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "VideoLessons" ? "active" : "")"
                           href="@Url.Action("Index", "VideoLessons")">
                            <i class="fas fa-video me-2"></i>Video Links
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Quizzes" ? "active" : "")"
                           href="@Url.Action("Index", "Quizzes")">
                            <i class="fas fa-brain me-2"></i>AI Quizzes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AiTutor" ? "active" : "")"
                           href="@Url.Action("Index", "AiTutor")">
                            <i class="fas fa-robot me-2"></i>AI Tutor
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AiSummary" ? "active" : "")"
                           href="@Url.Action("Index", "AiSummary")">
                            <i class="fas fa-file-alt me-2"></i>AI Summary
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "StudyPlanner" ? "active" : "")"
                           href="@Url.Action("Index", "StudyPlanner")">
                            <i class="fas fa-calendar-alt me-2"></i>Study Plan
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Progress" ? "active" : "")"
                           href="@Url.Action("Index", "Progress")">
                            <i class="fas fa-chart-line me-2"></i>My Progress
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "StudyRooms")" class="nav-link">
                            <i class="fas fa-video"></i>
                            <span>Study Rooms</span>
                        </a>
                    </li>

                    @*<li class="nav-item">
                            <a class="nav-link @(currentController == "Offline" ? "active" : "")"
                               href="@Url.Action("StudyPage", "Offline")">
                                <i class="fas fa-wifi-slash me-2"></i>Offline Study
                            </a>
                        </li>*@
                }
            </ul>

            @if (Session["UserId"] != null)
            {
                <div class="sidebar-footer">
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light w-100">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </button>
                    }
                </div>
            }
        </nav>

        <div id="content" class="content">
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-outline-primary">
                        <i class="fas fa-bars"></i>
                    </button>

                    <span class="navbar-brand ms-3 fw-bold text-primary">@ViewBag.Title</span>

                    <div class="ms-auto">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mb-0 py-2 px-3" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-0 py-2 px-3" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4">
                @RenderBody()
            </div>

            <footer class="mt-5 py-4 text-center text-muted border-top">
                <small>ThinkBridge 2026 - AI Online Learning Assistant - Group 21; </small>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('#content').toggleClass('active');
            });
        });
    </script>

    @RenderSection("scripts", required: false)

    <style>
        @@media (max-width: 768px) {

            .sidebar .components {
                padding-bottom: 120px !important;
            }

            .sidebar-footer {
                padding-top: 15px;
                background: #1c5dc6;
                position: sticky;
                bottom: 0;
                z-index: 10;
            }

            .sidebar .nav-item:last-child {
                margin-bottom: 25px !important;
            }

            .sidebar .nav-link {
                padding-top: 14px;
                padding-bottom: 14px;
            }
        }
    </style>
</body>
</html>