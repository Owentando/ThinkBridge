@model ThinkBridge.Models.VideoLesson
@{
    ViewBag.Title = Model.Title;
    var subject = ViewBag.Subject as ThinkBridge.Models.Subject;
    var topic = ViewBag.Topic as ThinkBridge.Models.Topic;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "VideoLessons")">Video Lessons</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <div class="ratio ratio-16x9 bg-dark rounded-top">
                    <iframe src="@Model.VideoUrl"
                            title="@Model.Title"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen>
                    </iframe>
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="mb-2">@Model.Title</h4>
                            <div class="mb-2">
                                <span class="badge bg-secondary me-1">@(subject?.Name ?? "N/A")</span>
                                <span class="badge bg-light text-dark">@(topic?.Name ?? "N/A")</span>
                            </div>
                        </div>
                        @if (Session["Role"].ToString() == "Student")
                        {
                            <button class="btn btn-outline-primary" onclick="generateAiNotes(@Model.Id)">
                                <i class="fas fa-magic me-2"></i>Generate AI Notes
                            </button>
                        }
                    </div>
                    <p class="text-muted">@Model.Description</p>
                    <small class="text-muted d-block">
                        <i class="fas fa-calendar me-1"></i>Added: @Model.CreatedAt.ToString("MMM dd, yyyy")
                    </small>
                </div>
            </div>
        </div>

        <!-- AI Notes Result -->
        <div id="aiNotesResult" class="d-none">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-robot me-2"></i>AI Generated Notes</h5>
                </div>
                <div class="card-body">
                    <div id="aiNotesContent" class="pre-wrap"></div>
                    <div class="mt-3">
                        <a href="@Url.Action("Index", "AiSummary")" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-history me-1"></i>View in Summaries
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Video Info</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Subject</small>
                    <strong>@(subject?.Name ?? "N/A")</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Topic</small>
                    <strong>@(topic?.Name ?? "N/A")</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">URL</small>
                    <a href="@Model.VideoUrl" target="_blank" class="small text-break">@Model.VideoUrl</a>
                </div>
                <hr />
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-success" onclick="saveOffline('Video', @Model.Id, '@Model.Title')">
                        <i class="fas fa-download me-2"></i>Save for Offline
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function generateAiNotes(videoId) {
            var btn = event.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating...';

            $.post('@Url.Action("GenerateAiNotes", "VideoLessons")', {
                id: videoId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(data) {
                if (data.success) {
                    $('#aiNotesContent').html(data.notes.replace(/\n/g, '<br>'));
                    $('#aiNotesResult').removeClass('d-none');
                    $('html, body').animate({
                        scrollTop: $('#aiNotesResult').offset().top - 20
                    }, 500);
                } else {
                    alert(data.message);
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-magic me-2"></i>Generate AI Notes';
            });
        }

        function saveOffline(itemType, itemId, title) {
            $.post('@Url.Action("Save", "Offline")', {
                itemType: itemType,
                itemId: itemId,
                title: title,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(data) {
                alert(data.success ? 'Saved for offline study!' : data.message);
            });
        }
    </script>
}