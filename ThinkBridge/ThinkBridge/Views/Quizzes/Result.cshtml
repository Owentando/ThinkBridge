@model ThinkBridge.ViewModels.QuizResultViewModel
@{
    ViewBag.Title = "Quiz Results - " + Model.QuizTitle;
    var isPassing = Model.Percentage >= 70;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Quizzes")">Quizzes</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "Quizzes", new { id = Model.QuizId })">@Model.QuizTitle</a></li>
            <li class="breadcrumb-item active">Results</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm text-center p-4 @(isPassing ? "border-success" : "border-warning")">
            <div class="mb-3">
                <i class="fas @(isPassing ? "fa-trophy text-success" : "fa-exclamation-circle text-warning") fa-4x"></i>
            </div>
            <h2 class="mb-2">@Model.Score / @Model.TotalQuestions</h2>
            <h3 class="@(isPassing ? "text-success" : "text-warning") mb-3">@Model.Percentage.ToString("F1")%</h3>
            <div class="progress mb-3" style="height: 20px;">
                <div class="progress-bar @(isPassing ? "bg-success" : "bg-warning")" style="width: @Model.Percentage%"></div>
            </div>
            <p class="text-muted mb-0">@(isPassing ? "Great job! You passed!" : "Keep practicing! You can do better.")</p>
        </div>
    </div>
</div>

<h5 class="mb-3"><i class="fas fa-list-check me-2"></i>Question Review</h5>
<div class="row">
    @foreach (var result in Model.QuestionResults)
    {
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm @(result.IsCorrect ? "border-success" : "border-danger")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="card-title mb-0">@result.QuestionText</h6>
                        <i class="fas @(result.IsCorrect ? "fa-check-circle text-success" : "fa-times-circle text-danger")"></i>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Your answer:</small>
                        <span class="@(result.IsCorrect ? "text-success fw-bold" : "text-danger")">@result.SelectedOptionText</span>
                    </div>
                    @if (!result.IsCorrect)
                    {
                        <div>
                            <small class="text-muted">Correct answer:</small>
                            <span class="text-success fw-bold">@result.CorrectOptionText</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!isPassing)
{
  <div class="text-center mt-4">
      @if (ViewBag.AttemptId != null)
      {
          <a href="@Url.Action("ConfusionReport", "Quizzes", new { attemptId = ViewBag.AttemptId })"
             class="btn btn-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              View Confusion Report
          </a>
      }
      else
      {
          <div class="alert alert-danger">
              Attempt ID missing. Cannot generate confusion report.
          </div>
      }
  </div>
}

<div class="text-center mt-4 mb-4">
    <a href="@Url.Action("Index", "Quizzes")" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-2"></i>Back to Quizzes
    </a>
</div>