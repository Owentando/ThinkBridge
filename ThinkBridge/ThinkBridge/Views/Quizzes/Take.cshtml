@model ThinkBridge.ViewModels.TakeQuizViewModel
@{
    ViewBag.Title = "Take Quiz - " + Model.QuizTitle;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Quizzes")">Quizzes</a></li>
            <li class="breadcrumb-item active">@Model.QuizTitle</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-question-circle me-2"></i>@Model.QuizTitle</h5>
                    <span class="badge bg-primary">@Model.Questions.Count Questions</span>
                </div>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Submit", "Quizzes", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="QuizId" value="@Model.QuizId" />

                    for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var question = Model.Questions[i];
                        <div class="quiz-question mb-4">
                            <h5 class="mb-3"><span class="badge bg-secondary me-2">@(i + 1)</span>@question.QuestionText</h5>
                            <div class="quiz-options">
                                @foreach (var option in question.Options)
                                {
                                    <label class="quiz-option d-flex align-items-center p-3 mb-2 rounded border">
                                        <input type="radio" name="question_@question.Id" value="@option.Id" class="form-check-input me-3" required />
                                        <span>@option.OptionText</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-check me-2"></i>Submit Quiz
                        </button>
                        <a href="@Url.Action("Index", "Quizzes")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .quiz-option {
        cursor: pointer;
        transition: all 0.2s;
    }

        .quiz-option:hover {
            background: #f8fafc;
            border-color: #4f46e5 !important;
        }

        .quiz-option input[type="radio"] {
            margin-top: 0;
        }
</style>