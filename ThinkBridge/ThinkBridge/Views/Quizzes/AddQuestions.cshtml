@{
    ViewBag.Title = "Add Questions";
    var quiz = ViewBag.Quiz as ThinkBridge.Models.Quiz;
    var existingQuestions = ViewBag.ExistingQuestions as List<ThinkBridge.Models.QuizQuestion>;
    var generatedQuestions = TempData["GeneratedQuestions"] as string;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Quizzes")">Quizzes</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "Quizzes", new { id = quiz.Id })">@quiz.Title</a></li>
            <li class="breadcrumb-item active">Add Questions</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0"><i class="fas fa-plus me-2"></i>Add Question Manually</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("AddQuestions", "Quizzes", new { id = quiz.Id }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Question Text</label>
                        <textarea name="questionText" class="form-control" rows="2" required placeholder="Enter your question"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Option A</label>
                            <input type="text" name="optionA" class="form-control" required placeholder="Option A" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Option B</label>
                            <input type="text" name="optionB" class="form-control" required placeholder="Option B" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Option C</label>
                            <input type="text" name="optionC" class="form-control" required placeholder="Option C" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Option D</label>
                            <input type="text" name="optionD" class="form-control" required placeholder="Option D" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correct Answer</label>
                        <select name="correctOption" class="form-select" required>
                            <option value="">Select correct option</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Question
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(generatedQuestions))
        {
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-robot me-2"></i>AI Generated Questions</h5>
                </div>
                <div class="card-body">
                    <pre class="mb-0" style="white-space: pre-wrap;">@generatedQuestions</pre>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0"><i class="fas fa-robot me-2"></i>Generate from Notes</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("GenerateFromNotes", "Quizzes", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quizId" value="@quiz.Id" />
                    <div class="mb-3">
                        <textarea name="notes" class="form-control" rows="6" placeholder="Paste your course notes here. AI will generate quiz questions based on this content." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fas fa-magic me-2"></i>Generate with AI
                    </button>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0">
                    <i class="fas fa-list-ol me-2"></i>
                    Existing Questions (@(existingQuestions == null ? 0 : existingQuestions.Count))
                </h6>            </div>
            <div class="card-body">
                @if (existingQuestions != null && existingQuestions.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var q in existingQuestions)
                        {
                            <div class="list-group-item px-0 py-2 border-0 border-bottom">
                                <small class="text-muted">Q@(existingQuestions.IndexOf(q) + 1)</small>
                                <p class="mb-0 small">@q.QuestionText</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <small>No questions added yet.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>