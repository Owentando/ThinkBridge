@model ThinkBridge.Models.StudyRoom

@{
    ViewBag.Title = "Join Study Room";
}

<style>
    .meeting-frame {
        width: 100%;
        height: 80vh;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        background: #000;
    }

    .room-header-card {
        border-radius: 18px;
    }

    .room-badge {
        font-size: 0.85rem;
    }
</style>

<div class="card shadow border-0 room-header-card mb-4">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-start flex-wrap">

            <div>
                <h3 class="fw-bold mb-2">
                    <i class="fas fa-video me-2 text-primary"></i>
                    @Model.Title
                </h3>

                <p class="text-muted mb-3">
                    @Model.Description
                </p>

                <div class="d-flex flex-wrap gap-2 mb-2">

                    @if (Model.Subject != null)
                    {
                        <span class="badge bg-primary room-badge">
                            @Model.Subject.Name
                        </span>
                    }

                    @if (Model.Topic != null)
                    {
                        <span class="badge bg-dark room-badge">
                            @Model.Topic.Name
                        </span>
                    }

                    @if (Model.IsLive)
                    {
                        <span class="badge bg-success room-badge">
                            Live Session
                        </span>
                    }
                </div>

                <small class="text-muted">
                    <i class="fas fa-user me-1"></i>
                    Hosted by
                    @(Model.CreatedByStudent != null
                        ? Model.CreatedByStudent.FullName
                        : "Student")
                </small>
            </div>

            <div class="mt-3 mt-md-0">
                <a href="@Url.Action("Index", "StudyRooms")"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </a>
            </div>

        </div>

    </div>
</div>

@if (Model.IsLive)
{
    <iframe class="meeting-frame"
            src="@ViewBag.RoomUrl"
            allow="camera; microphone; fullscreen; display-capture">
    </iframe>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        This study room has already ended.
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["Error"]
    </div>
}