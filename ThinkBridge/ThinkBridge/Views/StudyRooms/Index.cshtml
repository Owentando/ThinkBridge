@model IEnumerable<ThinkBridge.Models.StudyRoom>

@{
    ViewBag.Title = "Study Rooms";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="fas fa-video me-2"></i>Study Rooms
        </h3>
        <p class="text-muted mb-0">Start or join live student study calls.</p>
    </div>

    <a href="@Url.Action("Create", "StudyRooms")" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Start Study Room
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["Error"]
    </div>
}
@if (Model == null || !Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-users fa-3x mb-3"></i>
        <h5>No study rooms yet</h5>
        <p>Start a study room so other students can join and learn together.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold mb-0">@room.Title</h5>

                            @if (room.IsLive)
                            {
                                <span class="badge bg-success">Live</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ended</span>
                            }
                        </div>

                        <p class="text-muted small">@room.Description</p>

                        <div class="mb-2">
                            <span class="badge bg-primary me-1">
                                @(room.Subject != null ? room.Subject.Name : "General")
                            </span>

                            <span class="badge bg-light text-dark">
                                @(room.Topic != null ? room.Topic.Name : "No Topic")
                            </span>
                        </div>

                        <small class="text-muted d-block mb-3">
                            <i class="fas fa-user me-1"></i>
                            Started by @(room.CreatedByStudent != null ? room.CreatedByStudent.FullName : "Student")
                        </small>

                        <small class="text-muted d-block mb-3">
                            <i class="fas fa-clock me-1"></i>
                            @room.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                        </small>

                        <div class="d-flex gap-2">
                            @if (room.IsLive)
                            {
                                <a href="@Url.Action("Join", "StudyRooms", new { id = room.Id })"
                                   class="btn btn-sm btn-success">
                                    <i class="fas fa-video me-1"></i>Join
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled>
                                    Ended
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}