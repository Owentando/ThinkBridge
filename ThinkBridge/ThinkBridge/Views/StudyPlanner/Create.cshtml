@model ThinkBridge.ViewModels.CreateStudyPlanViewModel
@{
    ViewBag.Title = "Create Study Plan";
    var subjects = ViewBag.Subjects as List<ThinkBridge.Models.Subject> ?? new List<ThinkBridge.Models.Subject>();}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0"><i class="fas fa-magic me-2"></i>Create AI Study Plan</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    Our AI will analyze your quiz performance and create a personalized study schedule.
                </div>

                @using (Html.BeginForm("Create", "StudyPlanner", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.SubjectId, new { @class = "form-label fw-semibold" })
                        <select name="SubjectId" class="form-select" required>
                            <option value="">Select Subject</option>
                            @foreach (var subject in subjects)
                            {
                                <option value="@subject.Id">@subject.Name</option>
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.SubjectId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Topics, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Topics, new { @class = "form-control", rows = 3, placeholder = "List topics to cover, separated by commas (e.g., Linear Algebra, Matrices, Eigenvalues)" })
                        @Html.ValidationMessageFor(m => m.Topics, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.TestDate, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.TestDate, new { @class = "form-control", type = "date", min = DateTime.Now.ToString("yyyy-MM-dd") })
                        @Html.ValidationMessageFor(m => m.TestDate, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.DesiredMark, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.DesiredMark, new { @class = "form-control", type = "number", min = "0", max = "100", placeholder = "Enter target percentage" })
                            <span class="input-group-text">%</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.DesiredMark, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-magic me-2"></i>Generate Plan
                        </button>
                        <a href="@Url.Action("Index", "StudyPlanner")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>